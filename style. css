/* =====================================================
   SAYED KABIRAJ PORTFOLIO
   Modern Professional Theme
   Mobile First Responsive Design
===================================================== */


/* ================= ROOT ================= */

:root {

    --primary: #2563eb;
    --primary-light: #60a5fa;
    --primary-dark: #1d4ed8;

    --dark: #0b1120;
    --dark-card: #111827;

    --light: #f8fafc;
    --white: #ffffff;

    --text: #64748b;
    --text-light: #94a3b8;

    --border: rgba(148, 163, 184, 0.18);

    --shadow:
        0 20px 50px rgba(15, 23, 42, 0.12);

    --transition: 0.3s ease;
}


/* ================= DARK MODE ================= */

body.dark-mode {

    --light: #070b14;
    --white: #0f172a;

    --dark: #f8fafc;
    --dark-card: #111827;

    --text: #94a3b8;
    --text-light: #cbd5e1;

    --border: rgba(148, 163, 184, 0.15);

    --shadow:
        0 20px 50px rgba(0, 0, 0, 0.35);
}


/* ================= RESET ================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {

    font-family: "Poppins", sans-serif;

    background: var(--light);

    color: var(--dark);

    line-height: 1.7;

    overflow-x: hidden;

    transition:
        background 0.3s ease,
        color 0.3s ease;
}

a {
    text-decoration: none;
    color: inherit;
}

img {
    max-width: 100%;
    display: block;
}

button,
input,
textarea {
    font: inherit;
}


/* ================= SECTION ================= */

.section {

    width: 100%;

    padding:
        90px 6%;

}

.section-title {

    text-align: center;

    margin-bottom: 55px;

}

.section-title p {

    color: var(--primary);

    font-size: 13px;

    font-weight: 600;

    text-transform: uppercase;

    letter-spacing: 2px;

    margin-bottom: 8px;

}

.section-title h2 {

    font-size: 34px;

    line-height: 1.2;

}

.section-title h2 span {

    color: var(--primary);

}


/* ================= HEADER ================= */

.header {

    position: fixed;

    top: 0;
    left: 0;

    width: 100%;

    height: 70px;

    padding: 0 6%;

    display: flex;

    align-items: center;

    justify-content: space-between;

    background:
        color-mix(in srgb, var(--light) 90%, transparent);

    backdrop-filter: blur(15px);

    border-bottom: 1px solid var(--border);

    z-index: 1000;

}

.logo {

    font-size: 23px;

    font-weight: 700;

    letter-spacing: -1px;

}

.logo span,
.footer-logo span {

    color: var(--primary);

}


.header-actions {

    display: flex;

    align-items: center;

    gap: 10px;

}

.icon-btn,
.menu-btn {

    width: 40px;

    height: 40px;

    border: 1px solid var(--border);

    background: transparent;

    color: var(--dark);

    border-radius: 10px;

    cursor: pointer;

    display: grid;

    place-items: center;

}

.menu-btn {

    font-size: 21px;

}


/* ================= NAVBAR ================= */

.navbar {

    position: absolute;

    top: 70px;
    left: -100%;

    width: 100%;

    padding: 25px;

    background: var(--light);

    border-bottom: 1px solid var(--border);

    display: flex;

    flex-direction: column;

    gap: 15px;

    transition: 0.4s ease;

}

.navbar.active {

    left: 0;

}

.nav-link {

    font-size: 14px;

    color: var(--text);

    padding: 8px 0;

    transition: var(--transition);

}

.nav-link:hover,
.nav-link.active {

    color: var(--primary);

}


/* ================= HOME ================= */

.home {

    min-height: 100vh;

    padding-top: 130px;

    display: flex;

    flex-direction: column-reverse;

    justify-content: center;

    gap: 50px;

}

.home-content {

    text-align: center;

}

.welcome {

    color: var(--primary);

    font-weight: 600;

    margin-bottom: 10px;

}

.home h1 {

    font-size: clamp(42px, 12vw, 80px);

    line-height: 1;

    letter-spacing: -3px;

}

.home h1 span {

    color: var(--primary);

}

.home h2 {

    font-size: 20px;

    margin-top: 18px;

    color: var(--text);

}

.home h2 span {

    color: var(--dark);

}

.hero-text {

    max-width: 560px;

    margin: 20px auto;

    color: var(--text);

    font-size: 14px;

}

.hero-buttons {

    display: flex;

    justify-content: center;

    flex-wrap: wrap;

    gap: 12px;

    margin-top: 28px;

}

.btn {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    min-height: 48px;

    padding: 0 23px;

    border-radius: 8px;

    font-size: 13px;

    font-weight: 600;

    border: 1px solid var(--primary);

    transition: var(--transition);

}

.primary-btn {

    color: white;

    background: var(--primary);

}

.primary-btn:hover {

    background: var(--primary-dark);

    transform: translateY(-3px);

}

.outline-btn {

    color: var(--primary);

    background: transparent;

}

.outline-btn:hover {

    color: white;

    background: var(--primary);

}

.social-links {

    margin-top: 28px;

    display: flex;

    justify-content: center;

    gap: 22px;

}

.social-links a {

    color: var(--text);

    font-size: 12px;

    transition: var(--transition);

}

.social-links a:hover {

    color: var(--primary);

}


/* ================= PROFILE IMAGE ================= */

.home-image {

    display: flex;

    justify-content: center;

}

.image-box {

    width: 250px;

    height: 250px;

    position: relative;

    border-radius: 50%;

    display: grid;

    place-items: center;

}

.image-circle {

    position: absolute;

    width: 100%;
    height: 100%;

    border-radius: 50%;

    background:
        linear-gradient(
            135deg,
            var(--primary),
            var(--primary-light)
        );

    animation: float 5s ease-in-out infinite;

}

.image-box img {

    position: relative;

    width: 225px;

    height: 225px;

    object-fit: cover;

    border-radius: 50%;

    border: 7px solid var(--light);

}

@keyframes float {

    0%, 100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-12px);
    }

}


/* ================= ABOUT ================= */

.about {

    background:
        rgba(37, 99, 235, 0.03);

}

.about-container {

    display: grid;

    gap: 45px;

}

.about-image {

    min-height: 280px;

    display: grid;

    place-items: center;

}

.about-card {

    width: 85%;

    min-height: 230px;

    padding: 35px;

    border-radius: 20px;

    background:
        linear-gradient(
            135deg,
            var(--primary),
            var(--primary-dark)
        );

    color: white;

    display: flex;

    flex-direction: column;

    justify-content: flex-end;

    box-shadow: var(--shadow);

}

.about-card span {

    font-size: 13px;

    opacity: .7;

}

.about-card h3 {

    font-size: 30px;

    margin-top: 10px;

}

.about-card p {

    opacity: .8;

    font-size: 13px;

}

.about-content h3 {

    font-size: 25px;

    margin-bottom: 20px;

}

.about-content p {

    color: var(--text);

    font-size: 14px;

    margin-bottom: 15px;

}

.about-info {

    margin-top: 25px;

    display: grid;

    gap: 12px;

}

.about-info div {

    display: flex;

    flex-wrap: wrap;

    gap: 10px;

    font-size: 13px;

}

.about-info strong {

    min-width: 90px;

}

.about-info span {

    color: var(--text);

}


/* ================= SKILLS ================= */

.skills-container {

    display: grid;

    gap: 50px;

}

.skills-content h3 {

    font-size: 25px;

    margin-bottom: 10px;

}

.skills-content > p {

    color: var(--text);

    font-size: 14px;

    margin-bottom: 30px;

}

.skill {

    margin-bottom: 22px;

}

.skill-info {

    display: flex;

    justify-content: space-between;

    font-size: 13px;

    margin-bottom: 8px;

}

.skill-info span:last-child {

    color: var(--primary);

}

.skill-bar {

    width: 100%;

    height: 7px;

    border-radius: 20px;

    background: #e2e8f0;

    overflow: hidden;

}

.dark-mode .skill-bar {

    background: #1e293b;

}

.skill-bar span {

    display: block;

    height: 100%;

    border-radius: inherit;

    background:
        linear-gradient(
            90deg,
            var(--primary),
            var(--primary-light)
        );

    transform-origin: left;

    animation: skillAnimation 1.5s ease;

}

@keyframes skillAnimation {

    from {
        transform: scaleX(0);
    }

    to {
        transform: scaleX(1);
    }

}

.skill-cards {

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 15px;

}

.skill-card {

    padding: 22px;

    border: 1px solid var(--border);

    border-radius: 14px;

    background: var(--white);

    transition: var(--transition);

}

.skill-card:hover {

    transform: translateY(-6px);

    border-color: var(--primary);

}

.skill-card span {

    color: var(--primary);

    font-size: 12px;

}

.skill-card h3 {

    font-size: 18px;

    margin: 8px 0;

}

.skill-card p {

    color: var(--text);

    font-size: 11px;

}


/* ================= SERVICES ================= */

.services {

    background:
        rgba(37, 99, 235, 0.03);

}

.service-container {

    display: grid;

    gap: 18px;

}

.service-card {

    padding: 30px;

    border: 1px solid var(--border);

    background: var(--white);

    border-radius: 16px;

    transition: var(--transition);

}

.service-card:hover {

    transform: translateY(-8px);

    box-shadow: var(--shadow);

    border-color: var(--primary);

}

.service-number {

    color: var(--primary);

    font-size: 13px;

    font-weight: 600;

    margin-bottom: 35px;

}

.service-card h3 {

    font-size: 21px;

    margin-bottom: 10px;

}

.service-card p {

    color: var(--text);

    font-size: 13px;

}


/* ================= PROJECTS ================= */

.project-container {

    display: grid;

    gap: 25px;

}

.project-card {

    overflow: hidden;

    border: 1px solid var(--border);

    border-radius: 18px;

    background: var(--white);

    transition: var(--transition);

}

.project-card:hover {

    transform: translateY(-8px);

    box-shadow: var(--shadow);

}

.project-image {

    height: 190px;

    background:
        linear-gradient(
            135deg,
            #0f172a,
            var(--primary)
        );

    display: flex;

    align-items: flex-end;

    padding: 25px;

    color: white;

}

.project-image span {

    font-size: 12px;

    opacity: .7;

}

.project-content {

    padding: 25px;

}

.project-type {

    color: var(--primary);

    font-size: 11px;

    font-weight: 600;

    text-transform: uppercase;

}

.project-content h3 {

    font-size: 22px;

    margin: 7px 0;

}

.project-content > p {

    color: var(--text);

    font-size: 13px;

}

.project-tags {

    display: flex;

    flex-wrap: wrap;

    gap: 7px;

    margin: 18px 0;

}

.project-tags span {

    font-size: 10px;

    padding: 5px 10px;

    border-radius: 20px;

    color: var(--primary);

    background:
        rgba(37, 99, 235, 0.08);

}

.project-link {

    color: var(--primary);

    font-size: 12px;

    font-weight: 600;

}


/* ================= TIMELINE ================= */

.timeline {

    position: relative;

    max-width: 750px;

    margin: auto;

}

.timeline::before {

    content: "";

    position: absolute;

    left: 8px;

    top: 0;

    bottom: 0;

    width: 1px;

    background: var(--border);

}

.timeline-item {

    position: relative;

    padding-left: 35px;

    margin-bottom: 35px;

}

.timeline-dot {

    position: absolute;

    left: 0;

    top: 7px;

    width: 17px;

    height: 17px;

    border-radius: 50%;

    background: var(--primary);

    border: 4px solid var(--light);

    box-shadow:
        0 0 0 1px var(--primary);

}

.timeline-content {

    padding: 25px;

    border: 1px solid var(--border);

    border-radius: 14px;

    background: var(--white);

}

.timeline-date {

    color: var(--primary);

    font-size: 11px;

    font-weight: 600;

}

.timeline-content h3 {

    font-size: 18px;

    margin: 7px 0;

}

.timeline-content p {

    color: var(--text);

    font-size: 13px;

}


/* ================= EXPERIENCE ================= */

.experience-box {

    max-width: 850px;

    margin: auto;

    padding: 35px;

    display: flex;

    flex-direction: column;

    gap: 20px;

    border: 1px solid var(--border);

    border-radius: 18px;

    background: var(--white);

    text-align: center;

}

.experience-icon {

    width: 70px;

    height: 70px;

    display: grid;

    place-items: center;

    margin: auto;

    border-radius: 16px;

    color: white;

    background: var(--primary);

    font-size: 20px;

    font-weight: 700;

}

.experience-box h3 {

    font-size: 22px;

}

.experience-box p {

    color: var(--text);

    font-size: 13px;

}


/* ================= CONTACT ================= */

.contact {

    background:
        rgba(37, 99, 235, 0.03);

}

.contact-container {

    display: grid;

    gap: 45px;

}

.contact-info h3 {

    font-size: 28px;

    margin-bottom: 12px;

}

.contact-info > p {

    color: var(--text);

    font-size: 14px;

    margin-bottom: 30px;

}

.contact-item {

    display: flex;

    align-items: center;

    gap: 15px;

    margin-bottom: 20px;

}

.contact-item > span {

    width: 45px;

    height: 45px;

    display: grid;

    place-items: center;

    border-radius: 12px;

    color: var(--primary);

    background:
        rgba(37, 99, 235, 0.1);

}

.contact-item small {

    color: var(--text);

    font-size: 10px;

}

.contact-item p {

    font-size: 13px;

}


.contact-form {

    padding: 25px;

    border: 1px solid var(--border);

    border-radius: 18px;

    background: var(--white);

}

.input-group {

    margin-bottom: 15px;

}

.input-group input,
.input-group textarea {

    width: 100%;

    border: 1px solid var(--border);

    outline: none;

    background: transparent;

    color: var(--dark);

    border-radius: 9px;

    padding: 14px;

    font-size: 13px;

    transition: var(--transition);

}

.input-group input:focus,
.input-group textarea:focus {

    border-color: var(--primary);

}

.input-group textarea {

    resize: vertical;

}


/* ================= FOOTER ================= */

.footer {

    padding: 45px 6%;

    text-align: center;

    border-top: 1px solid var(--border);

}

.footer-logo {

    font-size: 24px;

    font-weight: 700;

}

.footer p {

    color: var(--text);

    font-size: 12px;

    margin-top: 8px;

}

.copyright {

    font-size: 10px !important;

}


/* ================= BACK TOP ================= */

.back-top {

    position: fixed;

    right: 20px;

    bottom: 20px;

    width: 42px;

    height: 42px;

    border: none;

    border-radius: 10px;

    background: var(--primary);

    color: white;

    cursor: pointer;

    opacity: 0;

    visibility: hidden;

    transform: translateY(20px);

    transition: var(--transition);

    z-index: 999;

}

.back-top.show {

    opacity: 1;

    visibility: visible;

    transform: translateY(0);

}


/* ================= SCROLL REVEAL ================= */

.reveal {

    opacity: 0;

    transform: translateY(35px);

    transition:
        opacity .7s ease,
        transform .7s ease;

}

.reveal.show {

    opacity: 1;

    transform: translateY(0);

}


/* =====================================================
   TABLET
===================================================== */

@media (min-width: 600px) {

    .section {

        padding:
            100px 8%;

    }

    .service-container {

        grid-template-columns:
            repeat(2, 1fr);

    }

    .project-container {

        grid-template-columns:
            repeat(2, 1fr);

    }

}


/* =====================================================
   DESKTOP
===================================================== */

@media (min-width: 900px) {

    .section {

        padding:
            110px 8%;

    }


    /* HEADER */

    .header {

        height: 80px;

    }

    .menu-btn {

        display: none;

    }

    .navbar {

        position: static;

        width: auto;

        padding: 0;

        border: none;

        background: transparent;

        display: flex;

        flex-direction: row;

        gap: 28px;

    }

    .nav-link {

        padding: 0;

        font-size: 12px;

    }


    /* HOME */

    .home {

        min-height: 100vh;

        padding-top: 120px;

        display: grid;

        grid-template-columns:
            1.2fr .8fr;

        align-items: center;

        gap: 60px;

    }

    .home-content {

        text-align: left;

    }

    .hero-text {

        margin-left: 0;

        margin-right: 0;

    }

    .hero-buttons {

        justify-content: flex-start;

    }

    .social-links {

        justify-content: flex-start;

    }

    .image-box {

        width: 360px;

        height: 360px;

    }

    .image-box img {

        width: 325px;

        height: 325px;

    }


    /* ABOUT */

    .about-container {

        grid-template-columns:
            .8fr 1.2fr;

        align-items: center;

        gap: 80px;

    }


    /* SKILLS */

    .skills-container {

        grid-template-columns:
            1.1fr .9fr;

        align-items: center;

        gap: 80px;

    }


    /* SERVICES */

    .service-container {

        grid-template-columns:
            repeat(3, 1fr);

    }


    /* CONTACT */

    .contact-container {

        grid-template-columns:
            .9fr 1.1fr;

        gap: 80px;

        align-items: start;

    }

    .contact-form {

        padding: 35px;

    }


    /* EXPERIENCE */

    .experience-box {

        flex-direction: row;

        text-align: left;

        align-items: center;

    }

    .experience-icon {

        margin: 0;

        flex-shrink: 0;

    }

}


/* =====================================================
   LARGE DESKTOP
===================================================== */

@media (min-width: 1200px) {

    .section {

        padding-left: 12%;

        padding-right: 12%;

    }

    .header {

        padding-left: 8%;

        padding-right: 8%;

    }

    .home h1 {

        font-size: 86px;

    }

}
/* ================= PREMIUM COLOR THEME ================= */

:root {

    --primary: #14b8a6;
    --primary-light: #2dd4bf;
    --primary-dark: #0f766e;

    --dark: #111827;
    --dark-card: #1f2937;

    --light: #f8fafc;
    --white: #ffffff;

    --text: #64748b;
    --text-light: #94a3b8;

    --border: rgba(15, 23, 42, 0.10);

    --shadow:
        0 20px 50px rgba(15, 23, 42, 0.12);

    --transition: 0.3s ease;
}


/* ================= DARK MODE ================= */

body.dark-mode {

    --light: #0b1120;
    --white: #111827;

    --dark: #f8fafc;
    --dark-card: #1f2937;

    --text: #94a3b8;
    --text-light: #cbd5e1;

    --border: rgba(148, 163, 184, 0.14);

    --shadow:
        0 20px 50px rgba(0, 0, 0, 0.35);
}
/* ================= EXPERIENCE ================= */

.experience {

    position: relative;

    background:
        linear-gradient(
            180deg,
            rgba(20, 184, 166, 0.03),
            transparent
        );

}


/* Experience Container */

.experience-container {

    display: grid;

    grid-template-columns: 1fr;

    gap: 20px;

    max-width: 1100px;

    margin: auto;

}


/* Experience Card */

.experience-card {

    position: relative;

    padding: 32px 25px;

    min-height: 310px;

    border: 1px solid var(--border);

    border-radius: 20px;

    background: var(--white);

    overflow: hidden;

    transition:
        transform .35s ease,
        border-color .35s ease,
        box-shadow .35s ease;

}


/* Top Glow */

.experience-card::before {

    content: "";

    position: absolute;

    top: -80px;

    right: -80px;

    width: 170px;

    height: 170px;

    border-radius: 50%;

    background:
        rgba(20, 184, 166, 0.10);

    transition: .4s ease;
